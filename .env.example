# SpecPilot local development environment (example — no secrets)

# Native macOS API/web against SpecPilot Compose Postgres on host port 5441:
DATABASE_URL=postgresql://specpilot:specpilot@localhost:5441/specpilot?schema=public

# Compose `api` service uses the internal hostname instead (set in compose.yaml):
# DATABASE_URL=postgresql://specpilot:specpilot@postgres:5432/specpilot?schema=public

# Do NOT point SpecPilot at axioma-db-dev (host port 5440) or foreign credentials.
# Real `.env` files are gitignored; copy this file to `.env` for native development.

PORT=3000

# PrimeUI Community license for Compose/Docker web builds (required).
# Use the same key as apps/web/src/environments/environment.local.ts (gitignored).
# Never commit the real value. Rebuild after setting:
#   docker compose build --no-cache web && docker compose up -d web
# PRIMEUI_LICENSE=

# Optional browser→API base URL baked into the web image (default is fine for local Compose).
# WEB_API_BASE_URL=http://localhost:3000

# Authorized host root for Compose API registration preflight (read-only bind mount).
# Used by compose.override.yaml (see compose.override.example.yaml).
# Must be an absolute path to a bounded directory of repositories — not `/` and not `$HOME`.
# SPECPILOT_HOST_REPOS_ROOT=/ABSOLUTE/PATH/TO/AUTHORIZED/REPOS/ROOT

# Optional DeepSeek API key for gateway probe (Compose api service forwards this).
# Leave empty for local runs that do not call DeepSeek. Never commit a real value.
DEEPSEEK_API_KEY=
