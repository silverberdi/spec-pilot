// SpecPilot persistence: AppMetadata probe + Project registration + ProjectConfigurationVersion (w01-s02)
// + latest discovery snapshot on Project (w01-s03) + ContextBundle manifest (w02-s03)
// + disclosure preview session / approval audit aggregates (w02-s04)
// + ReviewRun / ReviewRunTransition / ContextDisclosureTransmission (w03-s02).
// Budgets, findings, prompt-history, auth, and users remain later-slice scope.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_metadata")
}

model Project {
  id                               String                            @id @default(uuid())
  slug                             String                            @unique
  displayName                      String                            @map("display_name") @db.VarChar(120)
  repositoryPath                   String                            @unique @map("repository_path")
  status                           String
  registeredAt                     DateTime                          @default(now()) @map("registered_at")
  lastInspectedAt                  DateTime?                         @map("last_inspected_at")
  lastDiscovery                    Json?                             @map("last_discovery")
  configurationVersionId           String?                           @map("configuration_version_id")
  configurationVersions            ProjectConfigurationVersion[]     @relation("ProjectVersions")
  activeConfiguration              ProjectConfigurationVersion?      @relation("ActiveConfiguration", fields: [configurationVersionId], references: [id], onDelete: SetNull)
  contextBundles                   ContextBundle[]
  contextDisclosurePreviewSessions ContextDisclosurePreviewSession[]
  contextDisclosureApprovals       ContextDisclosureApproval[]
  reviewRuns                       ReviewRun[]
  contextDisclosureTransmissions   ContextDisclosureTransmission[]

  @@map("projects")
}

model ContextBundle {
  id                        String                            @id @default(uuid())
  projectId                 String                            @map("project_id")
  configurationVersionId    String                            @map("configuration_version_id")
  stage                     String
  sourceHash                String                            @map("source_hash")
  manifestSchemaVersion     Int                               @map("manifest_schema_version")
  selectionPolicyId         String                            @map("selection_policy_id")
  tokenEstimatorId          String                            @map("token_estimator_id")
  manifestHash              String                            @map("manifest_hash")
  entryCount                Int                               @map("entry_count")
  totalTokenEstimate        Int                               @map("total_token_estimate")
  candidatePathCount        Int                               @map("candidate_path_count")
  eligiblePathCount         Int                               @map("eligible_path_count")
  excludedPathCount         Int                               @map("excluded_path_count")
  findingCount              Int                               @map("finding_count")
  unscannableCount          Int                               @map("unscannable_count")
  entries                   Json
  exclusions                Json
  createdAt                 DateTime                          @default(now()) @map("created_at")
  project                   Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  disclosurePreviewSessions ContextDisclosurePreviewSession[]
  disclosureApprovals       ContextDisclosureApproval[]
  reviewRuns                ReviewRun[]
  transmissions             ContextDisclosureTransmission[]

  @@index([projectId, stage, createdAt])
  @@map("context_bundles")
}

// w02-s04: append-only, metadata-only preview session (design D1). No excerpts,
// file bodies, decoded text, raw bytes, or secret values are persisted here.
model ContextDisclosurePreviewSession {
  id                      String                      @id @default(uuid())
  projectId               String                      @map("project_id")
  contextBundleId         String                      @map("context_bundle_id")
  stage                   String
  configurationVersionId  String                      @map("configuration_version_id")
  sourceHash              String                      @map("source_hash")
  manifestSchemaVersion   Int                         @map("manifest_schema_version")
  selectionPolicyId       String                      @map("selection_policy_id")
  tokenEstimatorId        String                      @map("token_estimator_id")
  manifestHash            String                      @map("manifest_hash")
  previewPolicyId         String                      @map("preview_policy_id")
  previewIntegrityHash    String                      @map("preview_integrity_hash")
  itemCount               Int                         @map("item_count")
  previewedCodePointCount Int                         @map("previewed_code_point_count")
  createdAt               DateTime                    @default(now()) @map("created_at")
  expiresAt               DateTime                    @map("expires_at")
  project                 Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contextBundle           ContextBundle               @relation(fields: [contextBundleId], references: [id], onDelete: Cascade)
  approvals               ContextDisclosureApproval[]
  transmissions           ContextDisclosureTransmission[]

  @@index([projectId, contextBundleId, createdAt])
  @@map("context_disclosure_preview_sessions")
}

// w02-s04: append-only disclosure approval audit aggregate (design D2). Never
// updates/mutates ContextBundle or the preview session; contentTransmitted is
// a literal false snapshot at insert (approval-ready, not transmitted).
model ContextDisclosureApproval {
  id                     String                          @id @default(uuid())
  projectId              String                          @map("project_id")
  contextBundleId        String                          @map("context_bundle_id")
  previewSessionId       String                          @map("preview_session_id")
  stage                  String
  configurationVersionId String                          @map("configuration_version_id")
  sourceHash             String                          @map("source_hash")
  manifestSchemaVersion  Int                             @map("manifest_schema_version")
  selectionPolicyId      String                          @map("selection_policy_id")
  tokenEstimatorId       String                          @map("token_estimator_id")
  manifestHash           String                          @map("manifest_hash")
  previewPolicyId        String                          @map("preview_policy_id")
  approvalPolicyId       String                          @map("approval_policy_id")
  previewIntegrityHash   String                          @map("preview_integrity_hash")
  decision               String
  contentTransmitted     Boolean                         @map("content_transmitted")
  createdAt              DateTime                        @default(now()) @map("created_at")
  project                Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contextBundle          ContextBundle                     @relation(fields: [contextBundleId], references: [id], onDelete: Cascade)
  previewSession         ContextDisclosurePreviewSession   @relation(fields: [previewSessionId], references: [id], onDelete: Restrict)
  reviewRuns             ReviewRun[]
  transmissions          ContextDisclosureTransmission[]

  @@index([projectId, stage, createdAt])
  @@index([contextBundleId])
  @@index([previewSessionId])
  @@map("context_disclosure_approvals")
}

model ReviewRun {
  id                     String                        @id @default(uuid())
  projectId              String                        @map("project_id")
  configurationVersionId String                        @map("configuration_version_id")
  stage                  String
  changeId               String?                       @map("change_id")
  state                  String
  contextBundleId        String?                       @map("context_bundle_id")
  manifestHash           String?                       @map("manifest_hash")
  disclosureApprovalId   String?                       @map("disclosure_approval_id")
  previewSessionId       String?                       @map("preview_session_id")
  previewIntegrityHash   String?                       @map("preview_integrity_hash")
  previewPolicyId        String?                       @map("preview_policy_id")
  approvalPolicyId       String?                       @map("approval_policy_id")
  budgetCheckStatus      String?                       @map("budget_check_status")
  promptTemplateId       String?                       @map("prompt_template_id")
  modelAlias             String?                       @map("model_alias")
  resolvedModelId        String?                       @map("resolved_model_id")
  schemaId               String?                       @map("schema_id")
  verdict                String?
  rationale              String?
  attemptCount           Int?                          @map("attempt_count")
  latencyMs              Int?                          @map("latency_ms")
  promptTokens           Int?                          @map("prompt_tokens")
  completionTokens       Int?                          @map("completion_tokens")
  totalTokens            Int?                          @map("total_tokens")
  blockedCode            String?                       @map("blocked_code")
  failedCode             String?                       @map("failed_code")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  completedAt            DateTime?                     @map("completed_at")
  blockedAt              DateTime?                     @map("blocked_at")
  failedAt               DateTime?                     @map("failed_at")
  project                Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contextBundle          ContextBundle?                @relation(fields: [contextBundleId], references: [id], onDelete: Restrict)
  disclosureApproval     ContextDisclosureApproval?    @relation(fields: [disclosureApprovalId], references: [id], onDelete: Restrict)
  transitions            ReviewRunTransition[]
  transmission           ContextDisclosureTransmission?

  @@index([projectId, createdAt])
  @@index([projectId, stage, createdAt])
  @@map("review_runs")
}

model ReviewRunTransition {
  id          String    @id @default(uuid())
  reviewRunId String    @map("review_run_id")
  fromState   String?   @map("from_state")
  toState     String    @map("to_state")
  code        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  reviewRun   ReviewRun @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)

  @@index([reviewRunId, createdAt])
  @@map("review_run_transitions")
}

model ContextDisclosureTransmission {
  id                   String                          @id @default(uuid())
  projectId            String                          @map("project_id")
  reviewRunId          String                          @unique @map("review_run_id")
  contextBundleId      String                          @map("context_bundle_id")
  disclosureApprovalId String                          @map("disclosure_approval_id")
  previewSessionId     String                          @map("preview_session_id")
  manifestHash         String                          @map("manifest_hash")
  previewIntegrityHash String                          @map("preview_integrity_hash")
  previewPolicyId      String                          @map("preview_policy_id")
  approvalPolicyId     String                          @map("approval_policy_id")
  promptTemplateId     String                          @map("prompt_template_id")
  schemaId             String                          @map("schema_id")
  requestedModelAlias  String                          @map("requested_model_alias")
  resolvedModelId      String?                         @map("resolved_model_id")
  outcome              String
  attemptCount         Int?                            @map("attempt_count")
  latencyMs            Int?                            @map("latency_ms")
  promptTokens         Int?                            @map("prompt_tokens")
  completionTokens     Int?                            @map("completion_tokens")
  totalTokens          Int?                            @map("total_tokens")
  providerRequestId    String?                         @map("provider_request_id")
  terminalCode         String?                         @map("terminal_code")
  createdAt            DateTime                        @default(now()) @map("created_at")
  project              Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewRun            ReviewRun                       @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  contextBundle        ContextBundle                   @relation(fields: [contextBundleId], references: [id], onDelete: Restrict)
  disclosureApproval   ContextDisclosureApproval       @relation(fields: [disclosureApprovalId], references: [id], onDelete: Restrict)
  previewSession       ContextDisclosurePreviewSession @relation(fields: [previewSessionId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("context_disclosure_transmissions")
}

model ProjectConfigurationVersion {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  schemaVersion    Int       @map("schema_version")
  sourceHash       String    @map("source_hash")
  normalizedConfig Json      @map("normalized_config")
  validatedAt      DateTime  @map("validated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  project          Project   @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  activeFor        Project[] @relation("ActiveConfiguration")

  @@unique([projectId, sourceHash])
  @@map("project_configuration_versions")
}
