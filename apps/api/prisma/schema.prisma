// SpecPilot persistence-plane probe model only.
// Not a product domain model — later waves add domain tables via their own migrations.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_metadata")
}
